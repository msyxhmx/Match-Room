{
  "advisorModel": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m agent_tools.bash_gate",
            "timeout": 15,
            "statusMessage": "Checking the command with the bash gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|mcp__Claude_Browser__get_page_text|mcp__claude-in-chrome__get_page_text",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/python\" -m agent_tools.jev_hooks fetched",
            "timeout": 30,
            "statusMessage": "Checking the page for prompt injection with Jev"
          }
        ]
      }
    ]
  }
}
