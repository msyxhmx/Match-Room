{
  "name": "halftime-insights-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && VITE_PREVIEW=1 vite build",
    "dev:preview": "VITE_PREVIEW=1 vite",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:raw": "node scripts/check-raw-values.mjs",
    "shots": "node scripts/shots.mjs",
    "flows": "node scripts/flows.mjs",
    "motion": "node scripts/motion.mjs",
    "test:pitch": "node scripts/pitch-test.mjs",
    "film:pitch": "node scripts/pitch-film.mjs",
    "perf:pitch": "node scripts/pitch-perf.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
