    "Event": {
      "description": "One synthetic match event. Coordinates are 0-100, from the acting team's\npoint of view (x = 100 is the opponent's goal line).\n\nPass rows also carry end_x/end_y, speed_kmh and under_pressure; shot rows\ncarry speed_kmh. `pressure` rows are a defender closing down the ball\ncarrier (outcome \"applied\" or \"forced_error\"); `tackle`/`interception` rows\nwin the ball back after a failed pass (outcome \"won\").",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "minute": {
          "title": "Minute",
          "type": "integer"
        },
        "second": {
          "title": "Second",
          "type": "integer"
        },
        "side": {
          "enum": [
            "home",
            "away"
          ],
          "title": "Side",
          "type": "string"
        },
        "team_id": {
          "title": "Team Id",
          "type": "string"
        },
        "player": {
          "title": "Player",
          "type": "string"
        },
        "type": {
          "enum": [
            "pass",
            "shot",
            "foul",
            "card",
            "corner",
            "pressure",
            "tackle",
            "interception"
          ],
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "xg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xg"
        },
        "end_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End X"
        },
        "end_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Y"
        },
        "speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmh"
        },
        "under_pressure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Under Pressure"
        }
      },
      "required": [
        "event_id",
        "match_id",
        "minute",
        "second",
        "side",
        "team_id",
        "player",
        "type",
        "x",
        "y",
        "outcome"
      ],
      "title": "Event",
      "type": "object"
    },
