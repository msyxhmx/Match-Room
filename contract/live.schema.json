        "balanced"
      ],
      "title": "ControlProfile",
      "type": "object"
    },
    "ControlState": {
      "description": "Our own 'control vs chaos' composite over the last 10 minutes.",
      "properties": {
        "home_share": {
          "description": "0-1. Above 0.57 = home in control, below 0.43 = away.",
          "title": "Home Share",
          "type": "number"
        },
        "chaos": {
          "description": "0-1. Above 0.80 = chaotic phase.",
          "title": "Chaos",
          "type": "number"
        },
        "tempo": {
          "description": "Passes per minute, both teams, last 10 minutes.",
          "title": "Tempo",
          "type": "number"
        },
        "momentum": {
          "description": "-1 (away on top) to +1 (home on top), recency-weighted share of threat.",
          "title": "Momentum",
          "type": "number"
        },
        "phase": {
          "enum": [
            "home_control",
            "away_control",
            "chaos",
            "balanced"
          ],
          "title": "Phase",
          "type": "string"
        },
        "label": {
          "description": "Localised phrase for the phase, e.g. 'Northgate in control'.",
          "title": "Label",
          "type": "string"
        }
      },
